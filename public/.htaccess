# Apache configuration for azPDF (React SPA + PHP Backend)
Options -MultiViews
RewriteEngine On

# 1. Pass Authorization Header to PHP (Required for Auth tokens in cPanel/Apache)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# 2. Block direct web downloads of SQLite database and sensitive files
<FilesMatch "\.(db|sqlite|sqlite3|env|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Route all /api/* requests to PHP Backend
RewriteCond %{REQUEST_URI} ^.*/api(/.*)?$ [NC]
RewriteRule ^.*api(/.*)?$ backend/index.php [QSA,L]

# 4. React Single Page Application (SPA) fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

