# ==============================================================================
# azpdf - Backend Environment Configuration Example
# ==============================================================================

APP_ENV=development
APP_DEBUG=true
PORT=5000

# ==============================================================================
# Paddle Payment Gateway Configuration (Paddle Billing v2)
# ==============================================================================
# Mode: 'sandbox' or 'live'
PADDLE_ENV=sandbox
PADDLE_CURRENCY=USD
PADDLE_VENDOR_ID=your_vendor_id

# Live Keys
PADDLE_API_KEY=your_live_paddle_api_key
PADDLE_CLIENT_SIDE_TOKEN=your_live_client_side_token

# Sandbox Keys (Paddle Billing v2 Sandbox)
PADDLE_SANDBOX_API_KEY=your_sandbox_paddle_api_key
PADDLE_SANDBOX_CLIENT_SIDE_TOKEN=your_sandbox_client_side_token
